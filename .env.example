# LinkShelf — copia este archivo a .env y completa los valores.
# NUNCA commitees .env. La apiKey y el appId no van al repositorio:
# en local viven en .env; en Vercel y GitHub Actions se cargan como secrets.
#
# El build de la web y de la extensión lee estas variables FIREBASE_*.
# No son un secreto de acceso (las Security Rules autorizan), pero tampoco
# se versionan para no mezclar la config del proyecto con el código.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=linkshelf-hugo.firebaseapp.com
FIREBASE_PROJECT_ID=linkshelf-hugo
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# true fuerza los emuladores aunque exista apiKey.
# Si FIREBASE_API_KEY está vacío, el dev local usa los emuladores (demo-linkshelf).
FIREBASE_USE_EMULATORS=

# Opcional. Client ID OAuth web para el login con Google dentro de la extensión.
GOOGLE_OAUTH_CLIENT_ID=

# Emuladores locales (Firebase Emulator Suite). Los tests siempre usan demo-linkshelf.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Sitio público de la web (cuando exista el deploy).
SITE_URL=http://127.0.0.1:4200

# Modo personal. Listas separadas por comas. No son secretos, pero identifican
# la cuenta de Hugo: no hacen falta para el modo demo. El correo va en minúsculas.
# Tiene que coincidir con el documento Firestore config/access (ver README).
LINKSHELF_ALLOWED_UIDS=
LINKSHELF_ALLOWED_EMAILS=
