# LinkShelf - variables de entorno (copiar a .env y completar; NUNCA commitear .env)

# Supabase (públicas: protegidas por RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase (solo servidor / CI / Edge Functions; NUNCA en web ni extensión)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Web app (Angular) - se inyectan en build
NG_APP_SUPABASE_URL=
NG_APP_SUPABASE_ANON_KEY=
NG_APP_SITE_URL=

# Extensión (WXT expone variables con prefijo WXT_)
WXT_SUPABASE_URL=
WXT_SUPABASE_ANON_KEY=

# Edge Function normalize-link
NORMALIZE_FETCH_TIMEOUT_MS=5000
NORMALIZE_MAX_REDIRECTS=10
NORMALIZE_USER_AGENT=

# Fase posterior: LLM gratuito opcional para sugerir categoría
LLM_API_KEY=

# Despliegue (GitHub Actions secrets, no locales)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
