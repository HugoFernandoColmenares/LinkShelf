# LinkShelf - variables de entorno (copiar a .env y completar; NUNCA commitear .env)
#
# Configuración web de Firebase (proyecto en plan Spark, sin tarjeta).
# Estos valores NO son secretos: identifican el proyecto y viajan en el bundle
# de la web y de la extensión. La protección real son las Security Rules de
# Firestore y la lista de dominios autorizados de Firebase Auth.

# Web app (Angular) - se inyectan en build
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=        # <project-id>.firebaseapp.com
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_APP_ID=
NG_APP_FIREBASE_STORAGE_BUCKET=     # opcional (no se usa Cloud Storage)
NG_APP_FIREBASE_MESSAGING_SENDER_ID=
NG_APP_SITE_URL=
NG_APP_USE_EMULATORS=false          # true en desarrollo local
NG_APP_RECAPTCHA_ENTERPRISE_SITE_KEY=  # opcional: App Check

# Extensión (WXT expone variables con prefijo WXT_)
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_AUTH_DOMAIN=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_APP_ID=
# Client ID OAuth 2.0 de tipo "Aplicación web" (Google Cloud Console del mismo
# proyecto) con https://<extension-id>.chromiumapp.org/ como redirect URI
WXT_GOOGLE_OAUTH_CLIENT_ID=
WXT_USE_EMULATORS=false

# Resolución de redirecciones en la extensión (@linkshelf/core)
RESOLVE_FETCH_TIMEOUT_MS=5000
RESOLVE_MAX_REDIRECTS=10

# Emuladores locales (Firebase Emulator Suite)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Fase posterior: LLM gratuito opcional para sugerir categoría.
# Sin Cloud Functions no hay dónde esconder la clave: el usuario la pega en
# Opciones de la extensión y se guarda solo en chrome.storage.local.
# (No poner una clave real aquí.)

# Solo CI (GitHub Actions secrets, no locales)
FIREBASE_SERVICE_ACCOUNT=           # JSON de cuenta de servicio para desplegar reglas/índices
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
